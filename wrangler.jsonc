{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thor-when",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "thor-when.dylib.dev/*",
      "zone_id": "b0d85d4cddc9e3161051895d2602493d"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thor-when",
      "migrations_dir": "migrations",
      "database_id": "5d7b8ce0-aac4-4b24-becd-ebe4509168af",
      "remote": true
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://thor-when.dylib.dev"
  }
}
