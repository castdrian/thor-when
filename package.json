{
  "name": "thor-when",
  "private": true,
  "version": "0.1.0",
  "description": "an unofficial AYN Thor shipment estimator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/castdrian/thor-when.git"
  },
  "homepage": "https://thor-when.dylib.dev/",
  "keywords": [
    "ayn",
    "thor",
    "shipping",
    "estimator"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "dev:worker": "bun run build && wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check . --assist-enabled=false && bun run lint:svelte",
    "lint:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fetch-data": "bunx tsx scripts/fetch-dashboard.ts",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@cf-wasm/resvg": "0.4.0",
    "@fontsource/roboto": "5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.38.7",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.2.8",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.2.0",
    "happy-dom": "^20.11.2",
    "node-html-parser": "^9.0.1",
    "svelte-check": "^4.3.1",
    "tsx": "^4.20.3",
    "typescript": "~6",
    "vitest": "^4.1.10",
    "wrangler": "^4.124.0"
  }
}
